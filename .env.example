# Runtime settings
APP_ENV=development
CONFIG_FILE=config.yaml

# HTTP server
PERSONALITIES_APPS_NAME=personalities
PERSONALITIES_APPS_VERSION=dev
PERSONALITIES_APPS_ADDRESS=0.0.0.0
PERSONALITIES_APPS_HTTPPORT=8021

# PostgreSQL. Set HOST empty to run health checks without a database.
PERSONALITIES_POSTGRESQL_SKELETON_HOST=127.0.0.1
PERSONALITIES_POSTGRESQL_SKELETON_PORT=5432
PERSONALITIES_POSTGRESQL_SKELETON_USERNAME=personalities
PERSONALITIES_POSTGRESQL_SKELETON_PASSWORD=change-me
PERSONALITIES_POSTGRESQL_SKELETON_DB=personalities
PERSONALITIES_POSTGRESQL_SKELETON_SCHEMA=public
PERSONALITIES_POSTGRESQL_SKELETON_SSLMODE=disable
PERSONALITIES_POSTGRESQL_SKELETON_MINIDLECONNECTIONS=2
PERSONALITIES_POSTGRESQL_SKELETON_MAXOPENCONNECTIONS=10
PERSONALITIES_POSTGRESQL_SKELETON_MAXLIFETIME=300

# Basic Auth for /v1/users. Change these values before use.
PERSONALITIES_BASICAUTH_V1_USERNAME=api
PERSONALITIES_BASICAUTH_V1_PASSWORD=change-me

# Structured logs
PERSONALITIES_LOGGER_SYS_STDOUT=true
PERSONALITIES_LOGGER_TDR_STDOUT=true
